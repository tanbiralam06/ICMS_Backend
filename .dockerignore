# ============================================
# Docker Build Context Ignore File
# ============================================
# Reduces build context size and prevents sensitive/unnecessary files
# from being sent to the Docker daemon

# Dependencies - will be installed fresh in container
node_modules
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Environment files - sensitive data, use Docker secrets or env vars
.env
.env.*
!.env.example

# Version control
.git
.gitignore

# IDE and editor files
.idea
.vscode
*.swp
*.swo
*~

# OS generated files
.DS_Store
Thumbs.db

# Build artifacts
dist
build
coverage

# Development files
.prettierrc
.prettierignore
README.md
*.md

# Test files
src/tests
**/*.test.js
**/*.spec.js

# Docker files (no need to copy these into the image)
Dockerfile
Dockerfile.*
docker-compose*.yml
.dockerignore

# Logs
logs
*.log

# Temporary files
tmp
temp
.cache
